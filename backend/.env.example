# ---------------------------------------------------------------
# Playhouse Inventory API - environment template
# Copy to .env (never commit the real .env) and fill in real values.
# ---------------------------------------------------------------

# PostgreSQL connection string (Neon, Render Postgres, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# JWT - generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string-of-at-least-32-characters"
JWT_EXPIRATION="12h"

# Server
PORT=3000
NODE_ENV="production"

# Comma separated list of browser origins allowed to call the API.
# REQUIRED in production, e.g. your Vercel URL(s). No trailing slash.
CORS_ORIGIN="https://your-frontend.vercel.app"

# Behind Render / a proxy so rate limiting sees real client IPs
TRUST_PROXY=1

# Optional
SWAGGER_ENABLED=false
THROTTLE_LIMIT=200
BCRYPT_ROUNDS=12

# Seed (npm run prisma:seed). In production these MUST be set; existing users are never overwritten.
SEED_ADMIN_EMAIL="manager@yourshop.co.ke"
SEED_ADMIN_PASSWORD="ChangeMe-Str0ng!"
SEED_ADMIN_NAME="Store Manager"
SEED_STOREKEEPER_EMAIL="storekeeper@yourshop.co.ke"
SEED_STOREKEEPER_PASSWORD="ChangeMe-Str0ng!2"
