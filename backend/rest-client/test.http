### ============================================
### COMPLETE WORKFLOW TEST
### ============================================

### 1. Create Product
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "sku": "WF-TEST-001",
  "name": "Workflow Test Product",
  "costPrice": 10000,
  "reorderLevel": 20,
  "categoryId": "{{categoryId}}",
  "brandId": "{{brandId}}",
  "status": "ACTIVE"
}

### 2. Create Location (if needed)
POST {{baseUrl}}/locations
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Workflow Test Location"
}

### 3. Add Stock
POST {{baseUrl}}/inventory/stock-in
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "productId": "wf-test-product-id",
  "locationId": "wf-test-location-id",
  "quantity": 100,
  "reason": "Initial stock for workflow test"
}

### 4. Remove Stock
POST {{baseUrl}}/inventory/stock-out
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "productId": "wf-test-product-id",
  "locationId": "wf-test-location-id",
  "quantity": 30,
  "reason": "Sales for workflow test"
}

### 5. Check Stock Movements
GET {{baseUrl}}/stock-movements/product/wf-test-product-id
Authorization: Bearer {{adminToken}}

### 6. Check Current Stock
GET {{baseUrl}}/inventory/wf-test-product-id
Authorization: Bearer {{adminToken}}

### 7. Create Supplier
POST {{baseUrl}}/suppliers
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Workflow Test Supplier",
  "contactPerson": "Test Contact",
  "email": "test@workflow.com",
  "phone": "+254700000000"
}

### 8. Create Purchase Order
POST {{baseUrl}}/purchase-orders
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "supplierId": "wf-test-supplier-id",
  "expectedDate": "2026-10-01",
  "items": [
    {
      "productId": "wf-test-product-id",
      "quantity": 50,
      "unitCost": 9000
    }
  ]
}

### 9. Submit Purchase Order
POST {{baseUrl}}/purchase-orders/wf-test-po-id/submit
Authorization: Bearer {{adminToken}}

### 10. Approve Purchase Order
POST {{baseUrl}}/purchase-orders/wf-test-po-id/approve
Authorization: Bearer {{adminToken}}

### 11. Receive Goods
POST {{baseUrl}}/goods-receipts
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "purchaseOrderId": "wf-test-po-id",
  "locationId": "wf-test-location-id",
  "notes": "Workflow test receipt",
  "items": [
    {
      "productId": "wf-test-product-id",
      "receivedQuantity": 50,
      "damagedQuantity": 0
    }
  ]
}

### 12. Check Final Stock
GET {{baseUrl}}/inventory/wf-test-product-id
Authorization: Bearer {{adminToken}}

### 13. Check Audit Trail
GET {{baseUrl}}/audit/entity/Product/wf-test-product-id
Authorization: Bearer {{adminToken}}

