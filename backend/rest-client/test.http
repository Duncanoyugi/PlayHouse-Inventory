  "email": "shouldfail@test.com",
  "fullName": "Test Fail",
  "password": "Test@123",
  "role": "STOREKEEPER"
}

### ============================================
### ERROR TESTING
### ============================================

### Test Invalid Login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "wrong@email.com",
  "password": "wrongpassword"
}

### Test Unauthorized Access (No Token)
GET {{baseUrl}}/users

### Test Invalid Product Creation
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "sku": "",  // Empty SKU should fail
  "name": "Test",
  "costPrice": -100,  // Negative price should fail
  "reorderLevel": -5  // Negative reorder level should fail
}

### Test Insufficient Stock
POST {{baseUrl}}/inventory/stock-out
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "locationId": "{{locationId}}",
  "quantity": 9999,
  "reason": "Testing insufficient stock"
}

### Test Invalid Purchase Order Status Transition
POST {{baseUrl}}/purchase-orders/{{poId}}/approve
Authorization: Bearer {{adminToken}}
# This will fail if PO is not in SUBMITTED status

